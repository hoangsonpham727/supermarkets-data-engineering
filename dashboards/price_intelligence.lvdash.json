{
  "datasets": [
    {
      "name": "ds_price_comparison",
      "displayName": "Cross-retailer price comparison",
      "queryLines": [
        "SELECT snapshot_date, canonical_l1, canonical_l2, norm_unit_measure,\n",
        "       retailer, avg_norm_unit_price, is_cheapest\n",
        "FROM supermarket.gold.mart_price_comparison\n"
      ]
    },
    {
      "name": "ds_specials",
      "displayName": "Specials penetration",
      "queryLines": [
        "SELECT snapshot_date, retailer, canonical_l1, specials_pct, n_products\n",
        "FROM supermarket.gold.mart_specials_penetration\n"
      ]
    },
    {
      "name": "ds_price_index",
      "displayName": "Category price index",
      "queryLines": [
        "SELECT snapshot_date, retailer, canonical_l1, price_index, avg_norm_unit_price\n",
        "FROM supermarket.gold.mart_category_price_index\n"
      ]
    },
    {
      "name": "ds_availability",
      "displayName": "Availability rate",
      "queryLines": [
        "SELECT snapshot_date, retailer, availability_rate, n_listings\n",
        "FROM supermarket.gold.mart_availability\n"
      ]
    },
    {
      "name": "ds_dq",
      "displayName": "Data-quality scorecard",
      "queryLines": [
        "SELECT snapshot_date, retailer, n_rows, quarantine_pct, null_price_pct\n",
        "FROM supermarket.gold.mart_dq_scorecard\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_overview",
      "displayName": "Price Intelligence",
      "layout": [
        {
          "widget": {
            "name": "w_index_trend",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "ds_price_index",
                  "fields": [
                    {"name": "snapshot_date", "expression": "`snapshot_date`"},
                    {"name": "price_index", "expression": "AVG(`price_index`)"},
                    {"name": "retailer", "expression": "`retailer`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {"fieldName": "snapshot_date", "scale": {"type": "temporal"}},
                "y": {"fieldName": "price_index", "scale": {"type": "quantitative"}},
                "color": {"fieldName": "retailer", "scale": {"type": "categorical"}}
              },
              "frame": {"title": "Category price index by retailer (base day = 100)", "showTitle": true}
            }
          },
          "position": {"x": 0, "y": 0, "width": 6, "height": 6}
        },
        {
          "widget": {
            "name": "w_specials",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "ds_specials",
                  "fields": [
                    {"name": "retailer", "expression": "`retailer`"},
                    {"name": "specials_pct", "expression": "AVG(`specials_pct`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "retailer", "scale": {"type": "categorical"}},
                "y": {"fieldName": "specials_pct", "scale": {"type": "quantitative"}}
              },
              "frame": {"title": "Specials penetration % by retailer", "showTitle": true}
            }
          },
          "position": {"x": 6, "y": 0, "width": 6, "height": 6}
        },
        {
          "widget": {
            "name": "w_comparison",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "ds_price_comparison",
                  "fields": [
                    {"name": "canonical_l2", "expression": "`canonical_l2`"},
                    {"name": "retailer", "expression": "`retailer`"},
                    {"name": "avg_norm_unit_price", "expression": "AVG(`avg_norm_unit_price`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "table",
              "frame": {"title": "Avg normalised unit price by category & retailer", "showTitle": true}
            }
          },
          "position": {"x": 0, "y": 6, "width": 6, "height": 6}
        },
        {
          "widget": {
            "name": "w_availability",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "ds_availability",
                  "fields": [
                    {"name": "retailer", "expression": "`retailer`"},
                    {"name": "availability_rate", "expression": "AVG(`availability_rate`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "retailer", "scale": {"type": "categorical"}},
                "y": {"fieldName": "availability_rate", "scale": {"type": "quantitative"}}
              },
              "frame": {"title": "Availability rate % by retailer", "showTitle": true}
            }
          },
          "position": {"x": 6, "y": 6, "width": 3, "height": 6}
        },
        {
          "widget": {
            "name": "w_dq",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "ds_dq",
                  "fields": [
                    {"name": "retailer", "expression": "`retailer`"},
                    {"name": "quarantine_pct", "expression": "AVG(`quarantine_pct`)"},
                    {"name": "null_price_pct", "expression": "AVG(`null_price_pct`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "table",
              "frame": {"title": "Data-quality scorecard", "showTitle": true}
            }
          },
          "position": {"x": 9, "y": 6, "width": 3, "height": 6}
        }
      ]
    }
  ]
}
